{
  "name": "offline-field-issue-tracker-api",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Field Issue Tracker backend using Express, SQLite, and Zod",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "better-sqlite3": "11.3.0",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.7",
    "supertest": "7.0.0"
  }
}
